<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
            while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <!-- NOTE: Release 输出到 dist/；Debug 仍输出到游戏 mods/ 方便本地调试 -->
        <ModOutputDir Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)\dist\$(MSBuildProjectName)\</ModOutputDir>
        <ModOutputDir Condition="'$(Configuration)' != 'Release'">$(ModsPath)$(MSBuildProjectName)\</ModOutputDir>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')" >
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="False"> <!--Allows access to originally private/protected members but may (unlikely to) cause errors.-->
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="3.2.0" PrivateAssets="All"/>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />
        <!-- Generates a .pck file when building if only using simple assets. May not work on all setups. Uncomment to test. -->
        <PackageReference Include="BSchneppe.StS2.PckPacker" Version="0.1.1" PrivateAssets="All" />
        <!-- NOTE: ModAnalyzers 按文件名匹配本地化（Power → powers.json），需显式列入 AdditionalFiles -->
        <AdditionalFiles Include="Sts2BalanceMod/localization/**/*.json"/>
        <AdditionalFiles Include="Sts2BalanceMod/localization/eng/powers.json"/>
        <AdditionalFiles Include="Sts2BalanceMod/localization/zhs/powers.json"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Sts2BalanceMod/**" />
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <Compile Remove="docs/**" />
        <EmbeddedResource Remove="Sts2BalanceMod/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
        <None Include=".gitignore" />
        <None Include="Sts2BalanceMod.json" />
        <None Include="project.godot"/>
        <None Include="Sts2BalanceMod.sln" />
        <None Include="Sts2BalanceMod/**" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Sts2BalanceMod\images\card_portraits\big\" />
        <Folder Include="Sts2BalanceMod\images\powers\big\" />
        <Folder Include="Sts2BalanceMod\images\relics\big\" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths" >
        <Error
            Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
            Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    </Target>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
        <MakeDir Directories="$(ModOutputDir)" />
        <Message Text="Copying mod files to $(ModOutputDir)" Importance="high" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)" />
        <Copy SourceFiles="$(AssemblyName).json" DestinationFolder="$(ModOutputDir)" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModOutputDir)"
              Condition="'$(Configuration)' != 'Release'" />

        <!-- NOTE: 仅 Debug 构建时同步 BaseLib 到游戏 mods，方便本机联机调试 -->
        <Message Text="Copying BaseLib to mods folder." Importance="high"
                 Condition="'$(Configuration)' != 'Release'"/>
        <ItemGroup Condition="'$(Configuration)' != 'Release'">
            <BaseLibFiles Include="$(NuGetPackageRoot)alchyr.sts2.baselib/**/lib/**/BaseLib.dll;$(NuGetPackageRoot)alchyr.sts2.baselib/**/Content/BaseLib.pck;$(NuGetPackageRoot)alchyr.sts2.baselib/**/Content/BaseLib.json;"/>
        </ItemGroup>
        <Copy SourceFiles="@(BaseLibFiles)" DestinationFolder="$(ModsPath)BaseLib/"
              Condition="'$(Configuration)' != 'Release'"/>

        <!-- NOTE: 快速 PCK 不支持 .tscn，Debug 需直接复制资源文件到游戏 mods 目录 -->
        <Message Text="Copying resource dirs to $(ModOutputDir)" Importance="high"
                 Condition="'$(Configuration)' == 'Debug'"/>
        <Exec Command="xcopy /E /I /Y &quot;$(MSBuildProjectDirectory)\Sts2BalanceMod\monsters&quot; &quot;$(ModOutputDir)monsters&quot;"
              Condition="'$(Configuration)' == 'Debug'" />
        <Exec Command="xcopy /E /I /Y &quot;$(MSBuildProjectDirectory)\Sts2BalanceMod\images&quot; &quot;$(ModOutputDir)images&quot;"
              Condition="'$(Configuration)' == 'Debug'" />
        <Exec Command="xcopy /E /I /Y &quot;$(MSBuildProjectDirectory)\Sts2BalanceMod\localization&quot; &quot;$(ModOutputDir)localization&quot;"
              Condition="'$(Configuration)' == 'Debug'" />
    </Target>

    <Target Name="CopyQuickPck" AfterTargets="PackPck" Condition="Exists('$(PckPackerOutputPath)') And '$(PckPackerSkipped)' != 'true'">
        <Message Text="Copying quick .pck to $(ModOutputDir)" Importance="high"/>
        <Copy SourceFiles="$(PckPackerOutputPath)" DestinationFolder="$(ModOutputDir)" />
    </Target>

    <Target Name="NeedGodotForPublish" BeforeTargets="Publish">
        <Error Text=" Godot path must be set up before publishing; Godot not found at path '$(GodotPath)'. Check Directory.Build.props file."
            Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')"/>
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <MakeDir Directories="$(ModOutputDir)" />
        <Message Text="Exporting Godot .pck to $(ModOutputDir)" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModOutputDir)$(MSBuildProjectName).pck&quot;"
            EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1" />
    </Target>

    <!-- NOTE: Release 发布必须产出完整 pck，避免 Godot 导出失败后仍误报成功 -->
    <Target Name="VerifyReleaseOutputs" AfterTargets="GodotPublish;CopyQuickPck" Condition="'$(Configuration)' == 'Release'">
        <Error Text="Missing release dll: $(ModOutputDir)$(MSBuildProjectName).dll"
            Condition="!Exists('$(ModOutputDir)$(MSBuildProjectName).dll')" />
        <Error Text="Missing release json: $(ModOutputDir)$(MSBuildProjectName).json"
            Condition="!Exists('$(ModOutputDir)$(MSBuildProjectName).json')" />
        <Error Text="Missing release pck: $(ModOutputDir)$(MSBuildProjectName).pck. Check Godot export logs and Sts2BalanceMod.sln."
            Condition="!Exists('$(ModOutputDir)$(MSBuildProjectName).pck')" />
    </Target>
</Project>
