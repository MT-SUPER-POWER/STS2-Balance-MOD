; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sts2BalanceMod"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://Sts2BalanceMod/mod_image.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Sts2BalanceMod"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_clear_color=Color(0.0923724, 0.122398, 0.116929, 1)

